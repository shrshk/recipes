  "ingredients": [
    {
      "id": "pasta",
      "name": "small pasta",
      "qty": 200,
      "unit": "g",
      "substitutes": [
        {
          "name": "gluten-free pasta"
        }
      ]
    },
    {
      "id": "spinach",
      "name": "baby spinach",
      "qty": 2,
      "unit": "cups"
    },
    {
      "id": "cream-cheese",
      "name": "cream cheese",
      "qty": 3,
      "unit": "tbsp",
      "substitutes": [
        {
          "name": "dairy-free cream cheese"
        }
      ]
    },
    {
      "id": "parmesan",
      "name": "grated parmesan",
      "qty": 2,
      "unit": "tbsp",
      "optional": true
    },
    {
      "id": "oil",
      "name": "olive oil",
      "qty": 1,
      "unit": "tsp"
    }
  ],
  "steps": [
    {
      "text": "Boil the {pasta} until soft.",
      "minutes": 10
    },
    {
      "text": "Add the {spinach} for the last minute."
    },
    {
      "text": "Reserve a little water, then drain."
    },
    {
      "text": "Stir {list:cream-cheese,oil,parmesan} into the hot pasta with splashes of water."
    },
    {
      "text": "Chop any long strands and cool to warm.",
      "tip": "Chop spinach small so it does not clump."
    }
  ],
  "toddlerTips": [
    "Chop pasta and spinach small for younger toddlers.",
    "Skip extra salt.",
    "Reheat with a splash of milk."
  ],
