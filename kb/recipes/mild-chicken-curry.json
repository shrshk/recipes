{
  "id": "mild-chicken-curry",
  "title": "Mild Chicken Curry",
  "summary": "Tender chicken in a yogurt, tomato and onion gravy with warm spices and no chili heat.",
  "cuisine": "indian",
  "meals": [
    "dinner"
  ],
  "minAgeMonths": 12,
  "prepMinutes": 10,
  "cookMinutes": 40,
  "yield": 6,
  "difficulty": "medium",
  "tags": [
    "protein-packed",
    "family-meal",
    "freezer-friendly"
  ],
  "allergens": [
    "dairy"
  ],
  "ingredients": [
    {
      "id": "chicken",
      "name": "boneless chicken thighs",
      "qty": 500,
      "unit": "g",
      "note": "cut in small pieces"
    },
    {
      "id": "oil",
      "name": "oil",
      "qty": 2,
      "unit": "tbsp",
      "substitutes": [
        {
          "name": "ghee"
        }
      ]
    },
    {
      "id": "bay",
      "name": "bay leaf",
      "qty": 1,
      "unit": "",
      "optional": true
    },
    {
      "id": "cinnamon",
      "name": "cinnamon stick",
      "qty": 1,
      "unit": "inch",
      "optional": true
    },
    {
      "id": "cardamom",
      "name": "green cardamom pods",
      "qty": 3,
      "unit": "",
      "optional": true
    },
    {
      "id": "onion",
      "name": "onion",
      "qty": 1,
      "unit": "cup",
      "note": "finely chopped"
    },
    {
      "id": "ginger-garlic",
      "name": "ginger-garlic paste",
      "qty": 1,
      "unit": "tbsp"
    },
    {
      "id": "tomato",
      "name": "tomato",
      "qty": 0.5,
      "unit": "cup",
      "note": "pureed"
    },
    {
      "id": "turmeric",
      "name": "turmeric",
      "qty": 0.25,
      "unit": "tsp"
    },
    {
      "id": "yogurt",
      "name": "plain yogurt",
      "qty": 0.25,
      "unit": "cup",
      "note": "whisked",
      "substitutes": [
        {
          "name": "plain coconut yogurt",
          "qty": 1.5,
          "unit": "tbsp"
        }
      ]
    },
    {
      "id": "garam",
      "name": "garam masala",
      "qty": 1,
      "unit": "tsp"
    },
    {
      "id": "coriander-powder",
      "name": "ground coriander",
      "qty": 1,
      "unit": "tsp"
    },
    {
      "id": "chili-powder",
      "name": "Kashmiri chili powder",
      "qty": 0.5,
      "unit": "tsp",
      "note": "mild; mostly colour",
      "optional": true,
      "substitutes": [
        {
          "name": "sweet paprika"
        }
      ]
    },
    {
      "id": "water",
      "name": "hot water",
      "qty": 0.5,
      "unit": "cup",
      "note": "plus more as needed",
      "substitutes": [
        {
          "name": "light coconut milk"
        }
      ]
    },
    {
      "id": "coriander",
      "name": "fresh coriander",
      "qty": 2,
      "unit": "tbsp",
      "note": "finely chopped",
      "optional": true
    }
  ],
  "steps": [
    {
      "text": "Warm {oil} in a deep pan over medium heat.",
      "action": "fry"
    },
    {
      "text": "Add {list:bay,cinnamon,cardamom} and let them sizzle.",
      "action": "fry",
      "requires": [
        "bay",
        "cinnamon",
        "cardamom"
      ]
    },
    {
      "text": "Add {onion} and cook until deep golden.",
      "action": "fry",
      "minutes": 8
    },
    {
      "text": "Stir in {ginger-garlic} and cook for a minute.",
      "action": "fry",
      "minutes": 1
    },
    {
      "text": "Add {list:tomato,turmeric} and cook until soft and mushy.",
      "action": "fry",
      "minutes": 4
    },
    {
      "text": "Turn the heat low and stir in {list:yogurt,garam,coriander-powder,chili-powder}. Cook until fragrant.",
      "action": "fry",
      "minutes": 3,
      "tip": "Keep the heat low so the yogurt does not split."
    },
    {
      "text": "Add {chicken} and stir until it turns pale all over.",
      "action": "fry",
      "minutes": 3
    },
    {
      "text": "Pour in {water}, cover and simmer until the chicken is cooked through and very tender.",
      "action": "boil",
      "minutes": 20
    },
    {
      "text": "Pick out the whole spices.",
      "action": "prep",
      "requires": [
        "bay",
        "cinnamon",
        "cardamom"
      ],
      "tip": "Count the bay leaf, cinnamon and cardamom pods back out before serving."
    },
    {
      "text": "Stir in {coriander}.",
      "action": "mix",
      "requires": [
        "coriander"
      ]
    },
    {
      "text": "Cool until warm and serve with rice.",
      "action": "serve"
    }
  ],
  "toddlerTips": [
    "Leave out the green chilies; Kashmiri chili powder adds colour with very little heat.",
    "Shred the chicken or cut it into small, thin pieces for toddlers.",
    "Remove every whole spice before serving. Skip salt for toddlers."
  ],
  "sources": [
    {
      "platform": "blog",
      "url": "https://www.indianhealthyrecipes.com/chicken-curry/",
      "title": "Chicken Curry Recipe",
      "author": "Swasthi Shreekanth (Swasthi's Recipes)"
    }
  ],
  "popularity": 0.85
}
