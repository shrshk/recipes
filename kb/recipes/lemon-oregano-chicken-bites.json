{
  "id": "lemon-oregano-chicken-bites",
  "title": "Lemon Oregano Chicken Bites",
  "summary": "Roasted chicken pieces marinated in lemon, garlic and oregano.",
  "cuisine": "greek",
  "meals": [
    "dinner",
    "lunch"
  ],
  "minAgeMonths": 12,
  "prepMinutes": 10,
  "cookMinutes": 20,
  "difficulty": "easy",
  "tags": [
    "finger-food",
    "sheet-pan",
