{
  "id": "hidden-veg-pasta-sauce",
  "title": "Hidden Veg Pasta Sauce",
  "summary": "A smooth tomato sauce with carrot and courgette blended in.",
  "cuisine": "italian",
  "meals": [
    "lunch",
    "dinner"
  ],
  "minAgeMonths": 12,
  "prepMinutes": 10,
  "cookMinutes": 25,
  "yield": 6,
  "difficulty": "easy",
  "tags": [
    "hidden-veg",
    "batch-cook",
    "freezer-friendly",
    "picky-eater",
    "savory"
  ],
  "allergens": [],
  "ingredients": [
    {
      "id": "oil",
      "name": "olive oil",
      "qty": 1,
      "unit": "tbsp"
    },
    {
      "id": "onion",
      "name": "onion",
      "qty": 1,
      "unit": "",
      "note": "chopped"
    },
    {
      "id": "garlic",
      "name": "garlic cloves",
      "qty": 2,
      "unit": "",
      "optional": true
    },
    {
      "id": "carrot",
      "name": "carrots",
      "qty": 2,
      "unit": "",
      "note": "grated"
    },
    {
      "id": "zucchini",
      "name": "courgette",
      "qty": 1,
      "unit": "",
      "note": "grated"
    },
    {
      "id": "tomatoes",
      "name": "tinned chopped tomatoes",
      "qty": 800,
      "unit": "g"
    },
    {
      "id": "basil",
      "name": "dried basil",
      "qty": 1,
      "unit": "tsp",
      "optional": true
    },
    {
      "id": "pasta",
      "name": "pasta shapes",
      "qty": 250,
      "unit": "g",
      "substitutes": [
        {
          "name": "gluten-free pasta"
        }
      ]
    }
  ],
  "steps": [
    {
      "text": "Soften the {list:onion,garlic} in {oil}.",
      "minutes": 4
    },
    {
      "text": "Add {list:carrot,zucchini} and cook until soft.",
      "minutes": 6
    },
    {
      "text": "Pour in the {tomatoes} and {basil}."
    },
    {
      "text": "Simmer gently with the lid half on.",
      "minutes": 15
    },
    {
      "text": "Blend the sauce until smooth.",
      "tip": "Hot sauce splashes. Let it cool a little first."
    },
    {
      "text": "Cook the {pasta} until soft and drain."
    },
    {
      "text": "Toss the pasta with the sauce and cool to warm."
    }
  ],
  "toddlerTips": [
    "Cook pasta a little softer than adult al dente.",
    "No added salt; use no-salt tomatoes.",
    "Freeze sauce in single portions."
  ],
