{
  "id": "mild-chana-masala",
  "title": "Mild Chana Masala",
  "summary": "Soft chickpeas simmered in a smooth onion-tomato gravy with warm spices and no chili heat.",
  "cuisine": "indian",
  "meals": [
    "dinner",
    "lunch"
  ],
  "minAgeMonths": 12,
  "prepMinutes": 10,
  "cookMinutes": 35,
  "yield": 8,
  "difficulty": "easy",
  "tags": [
    "protein-packed",
    "iron-rich",
    "family-meal",
    "batch-cook",
    "freezer-friendly"
  ],
  "allergens": [],
  "ingredients": [
    {
      "id": "chickpeas",
      "name": "cooked chickpeas",
      "qty": 3,
      "unit": "cups",
      "note": "two 15 oz cans, drained, or 1 cup dried and pressure-cooked"
    },
    {
      "id": "oil",
      "name": "oil",
      "qty": 2,
      "unit": "tbsp",
      "substitutes": [
        {
          "name": "ghee",
          "note": "contains dairy"
        }
      ]
    },
    {
      "id": "bay",
      "name": "bay leaf",
      "qty": 1,
      "unit": "",
      "optional": true
    },
    {
      "id": "cinnamon",
      "name": "cinnamon stick",
      "qty": 1,
      "unit": "inch",
      "optional": true
    },
    {
      "id": "onion",
      "name": "onion",
      "qty": 1.5,
      "unit": "cups",
      "note": "finely chopped"
    },
    {
      "id": "ginger-garlic",
      "name": "ginger-garlic paste",
      "qty": 1,
      "unit": "tbsp"
    },
    {
      "id": "tomato",
      "name": "tomatoes",
      "qty": 1.5,
      "unit": "cups",
      "note": "finely chopped or pureed"
    },
    {
      "id": "turmeric",
      "name": "turmeric",
      "qty": 0.25,
      "unit": "tsp"
    },
    {
      "id": "coriander-powder",
      "name": "ground coriander",
      "qty": 2,
      "unit": "tsp"
    },
    {
      "id": "cumin-powder",
      "name": "ground cumin",
      "qty": 0.5,
      "unit": "tsp",
      "optional": true
    },
    {
      "id": "garam",
      "name": "garam masala",
      "qty": 0.75,
      "unit": "tsp"
    },
    {
      "id": "chili-powder",
      "name": "Kashmiri chili powder",
      "qty": 0.5,
      "unit": "tsp",
      "note": "mild; for colour",
      "optional": true
    },
    {
      "id": "water",
      "name": "water",
      "qty": 2,
      "unit": "cups",
      "note": "or the chickpea cooking liquid"
    },
    {
      "id": "methi",
      "name": "kasuri methi (dried fenugreek leaves)",
      "qty": 1,
      "unit": "tsp",
      "note": "crushed",
      "optional": true
    },
    {
      "id": "coriander",
      "name": "fresh coriander",
      "qty": 2,
      "unit": "tbsp",
      "note": "finely chopped",
      "optional": true
    }
  ],
  "steps": [
    {
      "text": "Warm {oil} in a large pot over medium heat.",
      "action": "fry"
    },
    {
      "text": "Add {list:bay,cinnamon} and let them sizzle.",
      "action": "fry",
      "requires": [
        "bay",
        "cinnamon"
      ]
    },
    {
      "text": "Add {onion} and cook until light golden, then stir in {ginger-garlic} for a minute.",
      "action": "fry",
      "minutes": 7
    },
    {
      "text": "Add {tomato} and cook until thick and pulpy.",
      "action": "fry",
      "minutes": 6
    },
    {
      "text": "Stir in {list:turmeric,coriander-powder,cumin-powder,garam,chili-powder} and cook until fragrant.",
      "action": "fry",
      "minutes": 3
    },
    {
      "text": "Take out any whole spices and blend the masala smooth.",
      "action": "blend",
      "tip": "Blending gives a smooth gravy toddlers prefer, with no onion bits."
    },
    {
      "text": "Return it to the pot with {chickpeas} and {water}. Cover and simmer until thick.",
      "action": "boil",
      "minutes": 15
    },
    {
      "text": "Mash a spoonful of chickpeas into the gravy to thicken it.",
      "action": "mash"
    },
    {
      "text": "Stir in {list:methi,coriander}.",
      "action": "mix",
      "requires": [
        "methi",
        "coriander"
      ]
    },
    {
      "text": "Cool until warm and serve with rice or roti.",
      "action": "serve"
    }
  ],
  "toddlerTips": [
    "Squash or halve chickpeas for under-twos; whole chickpeas can be a choking risk.",
    "Skip the green chili and salt for toddlers. Use no-salt-added canned chickpeas.",
    "Freezes well in small portions."
  ],
  "sources": [
    {
      "platform": "blog",
      "url": "https://www.indianhealthyrecipes.com/chana-masala/",
      "title": "Chana Masala (Chickpea Masala)",
      "author": "Swasthi Shreekanth (Swasthi's Recipes)"
    }
  ],
