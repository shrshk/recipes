{
  "id": "mexican-chicken-rice-bowl",
  "title": "Mexican Chicken Rice Skillet",
  "summary": "One-pan rice with chicken, tomato, corn and a gentle cumin flavor.",
  "cuisine": "mexican",
  "meals": [
    "dinner",
    "lunch"
  ],
