{
  "id": "cabbage-okonomiyaki-bites",
  "title": "Mini Cabbage Okonomiyaki",
  "summary": "Small soft cabbage pancakes, Japanese-style, that freeze well.",
  "cuisine": "japanese",
  "meals": [
    "lunch",
    "snack"
  ],
  "minAgeMonths": 12,
