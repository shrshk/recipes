{
  "id": "pea-and-bacon-risotto",
  "title": "Pea and Bacon Risotto",
  "summary": "A no-stir oven-hob risotto with soft peas and a little bacon; creamy and easy to spoon.",
  "cuisine": "italian",
  "meals": [
    "lunch",
    "dinner"
  ],
  "minAgeMonths": 12,
  "prepMinutes": 10,
  "cookMinutes": 35,
  "yield": 6,
  "difficulty": "easy",
  "tags": [
    "one-pot",
    "family-meal",
    "quick"
  ],
  "allergens": [
    "dairy"
  ],
  "ingredients": [
    {
      "id": "onion",
      "name": "onion",
      "qty": 1,
      "unit": "",
      "note": "finely chopped"
    },
    {
      "id": "oil",
      "name": "olive oil",
      "qty": 1,
      "unit": "tbsp"
    },
    {
      "id": "butter",
      "name": "butter",
      "qty": 10,
      "unit": "g",
      "optional": true,
      "substitutes": [
        {
          "name": "extra olive oil"
        }
      ]
    },
    {
      "id": "bacon",
      "name": "streaky bacon",
      "qty": 3,
      "unit": "rashers",
      "note": "chopped small",
      "optional": true,
      "substitutes": [
        {
          "name": "diced cooked chicken"
        },
        {
          "name": "diced mushrooms",
          "note": "vegetarian"
        }
      ]
    },
    {
      "id": "rice",
      "name": "risotto rice",
      "qty": 200,
      "unit": "g"
    },
    {
      "id": "stock",
      "name": "hot low-salt vegetable stock",
      "qty": 700,
      "unit": "ml"
    },
    {
      "id": "peas",
      "name": "frozen peas",
      "qty": 75,
      "unit": "g"
    },
    {
      "id": "parmesan",
      "name": "grated parmesan",
      "qty": 2,
      "unit": "tbsp",
      "optional": true
    }
  ],
  "steps": [
    {
      "text": "Soften the {onion} in {list:oil,butter} until lightly golden.",
      "action": "fry",
      "minutes": 7
    },
    {
      "text": "Add the {bacon} and fry until it starts to crisp.",
      "action": "fry",
      "minutes": 5,
      "requires": [
        "bacon"
      ]
    },
    {
      "text": "Tip in the {rice} and {stock}, stir well and bring to the boil.",
      "action": "boil"
    },
    {
      "text": "Cover, turn the heat down and simmer until the rice is almost tender.",
      "action": "boil",
      "minutes": 18
    },
    {
      "text": "Stir in the {peas} and cook until they are soft.",
      "action": "boil",
      "minutes": 4
    },
    {
      "text": "Serve with {parmesan} on top.",
      "action": "serve",
      "requires": [
        "parmesan"
      ]
    }
  ],
  "toddlerTips": [
    "Bacon is salty: use one rasher for under-2s, or swap it for chicken; skip any added salt.",
    "Squash a few peas with a fork for younger toddlers.",
    "Add a splash of hot water when reheating; risotto thickens as it cools."
  ],
