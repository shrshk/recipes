{
  "id": "mediterranean-veggie-egg-muffins",
  "title": "Mediterranean Egg Muffins",
  "summary": "Mini baked omelets with spinach, tomato and feta.",
  "cuisine": "mediterranean",
  "meals": [
    "breakfast",
    "snack"
  ],
  "minAgeMonths": 12,
