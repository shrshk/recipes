      "id": "plantain",
      "name": "very ripe plantains",
      "qty": 2,
      "unit": "",
      "note": "black-spotted"
    },
    {
      "id": "oil",
      "name": "coconut oil",
      "qty": 1,
      "unit": "tbsp",
      "substitutes": [
