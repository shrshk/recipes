    }
  ],
  "steps": [
    {
      "text": "Heat the oven to 200C/400F."
    },
    {
      "text": "Peel {plantain} and cut into thick fingers."
    },
    {
      "text": "Toss with {list:oil,cinnamon}."
    },
    {
      "text": "Bake, turning once.",
      "minutes": 20
    },
    {
      "text": "Cool and serve soft."
    }
  ],
