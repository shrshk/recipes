{
  "id": "gyeran-mari",
  "title": "Gyeran-mari Rolled Omelet",
  "summary": "Korean rolled egg omelet with tiny veg, cut into finger slices.",
  "cuisine": "korean",
  "meals": [
    "breakfast",
    "lunch",
    "snack"
  ],
  "minAgeMonths": 12,
  "prepMinutes": 5,
