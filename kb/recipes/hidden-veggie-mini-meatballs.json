    "iron-rich",
    "protein-packed"
  ],
  "allergens": [
    "egg",
    "gluten",
    "wheat",
    "dairy"
  ],
  "ingredients": [
    {
      "id": "beef",
      "name": "lean minced beef",
      "qty": 500,
      "unit": "g",
      "substitutes": [
        {
          "name": "minced turkey"
        },
        {
          "name": "minced chicken"
        }
      ]
    },
    {
      "id": "zucchini",
      "name": "grated courgette",
      "qty": 0.5,
      "unit": "cup",
      "note": "squeezed dry"
    },
    {
      "id": "onion",
      "name": "onion",
      "qty": 1,
      "unit": "",
      "note": "small, grated"
    },
    {
      "id": "carrot",
      "name": "grated carrot",
      "qty": 0.5,
      "unit": "cup"
    },
    {
      "id": "breadcrumbs",
      "name": "breadcrumbs",
      "qty": 0.5,
      "unit": "cup",
      "substitutes": [
        {
          "name": "gluten-free breadcrumbs"
        },
        {
          "name": "oats"
        }
      ]
    },
    {
      "id": "egg",
      "name": "egg",
      "qty": 1,
      "unit": "",
      "substitutes": [
        {
          "name": "milk",
          "qty": 2,
          "unit": "tbsp"
        }
      ]
    },
    {
      "id": "parmesan",
      "name": "grated parmesan",
      "qty": 0.25,
      "unit": "cup",
      "optional": true
    },
    {
      "id": "herbs",
      "name": "dried oregano",
      "qty": 1,
      "unit": "tsp",
      "optional": true
    }
  ],
  "steps": [
    {
      "text": "Heat the oven to 200C / 400F and line a tray."
    },
    {
      "text": "Mix {list:beef,onion,zucchini,carrot,breadcrumbs,egg,parmesan,herbs} well."
    },
    {
      "text": "Roll into small balls about the size of a walnut."
    },
    {
      "text": "Bake until browned and cooked through.",
      "minutes": 15,
      "tip": "Cut one open to check there is no pink."
    },
    {
      "text": "Cool, then cut each ball in half."
    }
  ],
  "toddlerTips": [
    "Squash or halve meatballs; round balls are a choking risk.",
    "Use low-salt sauce for dipping.",
    "Freeze cooled meatballs flat on a tray, then bag."
  ],
