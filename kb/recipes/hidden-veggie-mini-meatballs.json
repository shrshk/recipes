{
  "id": "hidden-veggie-mini-meatballs",
  "title": "Hidden Veggie Mini Meatballs",
  "summary": "Baked beef meatballs with grated veg that freeze well.",
  "cuisine": "italian",
  "meals": [
    "lunch",
    "dinner"
  ],
  "minAgeMonths": 12,
