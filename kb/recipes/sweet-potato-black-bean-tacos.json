{
  "id": "sweet-potato-black-bean-tacos",
  "title": "Sweet Potato Black Bean Tacos",
  "summary": "Soft mild tacos with mashed sweet potato, beans and avocado.",
  "cuisine": "mexican",
  "meals": [
    "dinner",
    "lunch"
  ],
  "minAgeMonths": 12,
